public int[] maxSlidingWindow(int[] nums, int k) {    if (nums == null || nums.length == 0) {        return new int[0];    }    int length = nums.length;    int[] array = new int[length - k + 1];    Deque<Integer> queue = new ArrayDeque<>();    for (int i = 0; i < (k - 1); i++) {        while (!queue.isEmpty() && nums[i] > nums[queue.peekLast()]) {            queue.pollLast();        }        queue.offerLast(i);    }    for (int i = k - 1; i < length; i++) {        while (!queue.isEmpty() && nums[i] > nums[queue.peekLast()]) {            queue.pollLast();        }        queue.offerLast(i);        if (i - queue.peekFirst() >= k) {            queue.removeFirst();        }        array[i - k + 1] = nums[queue.peekFirst()];    }    return array;}

