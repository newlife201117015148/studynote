int power(int x, int n)

{

    int result;

    if(n == 1)

        return x;

    if( n % 2 == 0)

        result = power(x, n/2) * power(x, n / 2);

    else

        result = power(x, (n+1) / 2) * power(x, (n-1) / 2);


    return result;

}

