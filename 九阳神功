public int lengthOfLongestSubstring(String s) {    if (s == null || s.isEmpty()) {        return 0;    }    int left = 0;    int len = s.length();    int ans = 0;    int[] occurs = new int[128];    Arrays.fill(occurs, -1);    char[] chars = s.toCharArray();    for (int right = 0; right < len; right++) {        char letter = chars[right];        if (occurs[letter] != -1) {            left = Math.max(left, occurs[letter] + 1);        }        ans = Math.max(ans, right - left + 1);        occurs[letter] = right;    }    return ans;}public int lengthOfLongestSubstring(String s) {    if (s == null || s.isEmpty()) {        return 0;    }    int left = 0;    int len = s.length();    int ans = 0;    int[] occurs = new int[128];    Arrays.fill(occurs, -1);    char[] chars = s.toCharArray();    for (int right = 0; right < len; right++) {        char letter = chars[right];        if (occurs[letter] != -1) {            left = Math.max(left, occurs[letter] + 1);        }        ans = Math.max(ans, right - left + 1);        occurs[letter] = right;    }    return ans;}


