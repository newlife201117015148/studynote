public int[] maxSlidingWindow(int[] nums, int k) {    LinkedList<Integer> wnd = new LinkedList<>();    int left = 0;    int right = 0;    int len = nums.length;    int max = Integer.MIN_VALUE;    List<Integer> res = new ArrayList<>();    while (right < len) {        wnd.add(nums[right++]);        while (wnd.size() >= k) {            max = wnd.stream().max((a, b) -> a - b).get();            res.add(max);            wnd.removeFirst();            left++;        }    }    int[] ans = new int[res.size()];    for (int i = 0; i < res.size(); i++) {        ans[i] = res.get(i);    }    return ans;}




