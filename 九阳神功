class StockSpanner {    Deque<Integer> prices;    Deque<Integer> weights;    public StockSpanner() {        prices = new LinkedList<>();        weights = new LinkedList<>();    }    public int next(int price) {        int cross = 1;        while (!prices.isEmpty() && price >= prices.peek()) {            prices.pop();            cross += weights.pop();        }        prices.push(price);        weights.push(cross);        return cross;    }}


